{
  "manifest_version": 3,
  "name": "yt-redirector",
  "version": "1.0",
  "description": "A slowly-growing delay before YouTube loads. While you wait, you read your book.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "unlimitedStorage",
    "tabs"
  ],
  "host_permissions": ["*://*.youtube.com/*", "https://api.gumroad.com/*"],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Read now",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_page": "library.html",
  "web_accessible_resources": [
    { "resources": ["reader.html"], "matches": ["<all_urls>"] }
  ]
}
